<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Title>BlazorEasyAuth</Title>
        <PackageProjectUrl>https://github.com/Rene-Sackers/BlazorEasyAuth</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Rene-Sackers/BlazorEasyAuth</RepositoryUrl>
        <LangVersion>default</LangVersion>
        <TargetFramework>net9.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.AspNetCore.Authentication" Version="2.3.0" />
      <PackageReference Include="Microsoft.AspNetCore.Authentication.Cookies" Version="2.3.0" />
      <PackageReference Include="Microsoft.AspNetCore.Authorization" Version="9.0.1" />
      <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="9.0.1" />
      <PackageReference Include="Microsoft.AspNetCore.CookiePolicy" Version="2.3.0" />
      <PackageReference Include="Microsoft.AspNetCore.Mvc" Version="2.3.0" />
    </ItemGroup>

</Project>
